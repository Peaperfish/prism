# Prism recipe: edit settings in plain text. Prism rewrites these comments when it saves.
# What each line means: https://github.com/Peaperfish/prism/blob/main/docs/RECIPES.md
prism_recipe = 1  # recipe format version
name = "Vivid"
description = "More colour and contrast"

[exposure]
stops = +0.0  # 1.00x the light

[saturation]
amount = 1.2  # 1.20x the colourfulness

[contrast]
amount = 1.1  # each stop near middle grey is 10% wider

[curve]
shape = "none"  # no tone curve
